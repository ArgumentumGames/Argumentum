@* Fixture template for #457 round-trip test. Miniature, audit-anchored, NOT production. *@
@inherits Custom.Hybrid.Razor12
@using System.Linq

<div class="rule-detail">
  <h2>@Resources.RuleSummary</h2>
  <p>@ruleEntity.Summary</p>

  <h2>@Resources.RuleMaterial</h2>
  <h5>de @ruleEntity.MinNbPlayers &agrave; @ruleEntity.MaxNbPlayers joueurs </h5>

  <h2>@Resources.RuleInstallation</h2>
  <h2>@Resources.RuleVariants</h2>
  <h2>@Resources.RuleMemoCard</h2>
  <p>@Html.Raw(@Resources.RuleMemoInstructions)</p>
  <h3>@Resources.RuleMemoCardFileNamePrefix</h3>
  <a href="@downloadUrl">@Resources.RuleMemoCardDownload</a>
</div>
