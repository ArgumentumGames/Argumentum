<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- #1674 : nullabilite en erreur (NU190x exclus de l'organe) -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableVerify>true</EnableVerify>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.43.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argumentum.AssetConverter\Argumentum.AssetConverter.csproj" />
  </ItemGroup>

  <!-- TestRepoRoot: linked compile (ai-01 arbitrage 2', msg 3y8vuy). The helper lives in
       Tests/TestRepoRoot.cs and is compiled INTO this assembly, so it is internal here too.
       Not a ProjectReference (no build edge between the two suites, which #1054 separated
       into different execution regimes), not a duplicate (single source on disk — a walk-up
       fix benefits both suites). The file declares namespace Argumentum.AssetConverter.Tests,
       hence the `using Argumentum.AssetConverter.Tests;` in the consumers below. -->
  <ItemGroup>
    <Compile Include="..\Argumentum.AssetConverter.Tests\TestRepoRoot.cs" Link="TestRepoRoot.cs" />
    <!-- #1187 PDF card-count organ : mêmes règles que TestRepoRoot ci-dessus (source unique sur
         disque, compilée dans cet assembly — pas de ProjectReference entre les deux suites #1054,
         pas de duplicata). L'organe pur vit dans Tests/PdfAssembly/, le comparateur bundle
         (PdfCardCountIntegrityTests.cs, ce projet) le consomme via ce link. -->
    <Compile Include="..\Argumentum.AssetConverter.Tests\HarvestCardIdsCsv.cs" Link="HarvestCardIdsCsv.cs" />
    <Compile Include="..\Argumentum.AssetConverter.Tests\PdfAssembly\PdfCardCountIntegrity.cs" Link="PdfAssembly\PdfCardCountIntegrity.cs" />
    <Compile Include="..\Argumentum.AssetConverter.Tests\PdfAssembly\PdfDeckCountDerivation.cs" Link="PdfAssembly\PdfDeckCountDerivation.cs" />
    <!-- #1460 phase A : le vérificateur de géométrie (pur, témoins en CI dans PdfStructurePhaseAContractTests)
         et la garde d'arbre. Mêmes règles que ci-dessus : source unique sur disque, compilée ici,
         aucun ProjectReference entre les deux suites (#1054). L'organe qui ouvre les PDF vit dans
         ce projet parce que PdfPig n'est référencé qu'ici. -->
    <Compile Include="..\Argumentum.AssetConverter.Tests\PdfAssembly\PdfPageGeometryIntegrity.cs" Link="PdfAssembly\PdfPageGeometryIntegrity.cs" />
    <!-- #1460 phase C : le moteur d'ordre « Rules d'abord » (pur, témoins en CI dans
         Structure/RulesFirstOrderIntegrityTests.cs). Mêmes règles que ci-dessus : source unique
         sur disque, compilée ici, aucun ProjectReference entre les deux suites (#1054). L'organe
         qui ouvre les PDF vit dans ce projet ; la mesure passe par Magick.NET, qui délègue le PDF
         à Ghostscript (⚠️ absent du PATH = échec nommé, jamais un skip). -->
    <Compile Include="..\Argumentum.AssetConverter.Tests\Structure\RulesFirstOrderIntegrity.cs" Link="Structure\RulesFirstOrderIntegrity.cs" />
    <!-- #1460 phase C organe 2 : le moteur de couleur de famille (pur, témoins en CI dans
         Structure/FamilyColorIntegrityTests.cs). Mêmes règles : source unique sur disque, compilée
         ici, aucun ProjectReference entre les deux suites (#1054). Cet organe-ci n'ouvre aucun PDF —
         seulement les PNG de récolte via Magick.NET, aucun Ghostscript requis. -->
    <Compile Include="..\Argumentum.AssetConverter.Tests\Structure\FamilyColorIntegrity.cs" Link="Structure\FamilyColorIntegrity.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
