<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyVersion>1.3</AssemblyVersion>
    <FileVersion>1.3</FileVersion>
    <Copyright>Argumentum</Copyright>
    <Authors>Argumentum</Authors>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="CsvHelper" Version="34.1.0" />
    <PackageReference Include="dotNetRdf" Version="3.5.2" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.78.0.4330" />
    <PackageReference Include="ExtendedXmlSerializer" Version="3.10.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.43.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OWLSharp" Version="5.0.1" />
    <PackageReference Include="OWLSharp.Extensions" Version="5.0.1" />
    <PackageReference Include="QuestPDF" Version="2022.12.12" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Json" Version="0.57.2" />
    <PackageReference Include="System.ComponentModel.TypeConverter" Version="4.3.0" />
    <PackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Utf8Json" Version="1.3.7" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Target\" />
    <Folder Include="Published\v1.3\" />
  </ItemGroup>
	
  <ItemGroup>
    <None Update="DatasetUpdater\Resources\*.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DatasetUpdater\Resources\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Logo_Argumentum &amp; QRCode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Logo_Argumentum &amp; QRCode_Fallacies.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Logo_Argumentum.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="AssetConverterConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Mindmapper\xslt\mm2svg.xslt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Mindmapper\xslt\polyfill.xslt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Mindmapper\xslt\Export-FreeMindSvg.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Argumentum.AssetConverter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mindmapper\xslt\polyfill.xslt" />
    <EmbeddedResource Include="Mindmapper\xslt\mm2svg.xslt" />
  </ItemGroup>

</Project>
