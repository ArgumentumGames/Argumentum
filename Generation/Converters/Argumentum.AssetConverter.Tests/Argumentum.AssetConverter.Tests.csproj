    </None>
    <None Update="Assets\PdfAssemblyTest\**\*">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
       </None>
     </ItemGroup>
   
     <ItemGroup>
       <EmbeddedResource Include="Assets\Mindmap\sample_fallacy_map.svg" />
     </ItemGroup>
   
   </Project>
