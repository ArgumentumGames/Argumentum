  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argumentum.AssetConverter\Argumentum.AssetConverter.csproj" />
  </ItemGroup>

</Project>
