  <data name="AdvancedSearchHint.Text" xml:space="preserve">
    <value>&lt;table class="dnnSearchResult-hint-tbl dnnTableDisplay"&gt;

                
				&lt;tr&gt;
                    &lt;th style="width: 150px"&gt;&lt;span&gt;النوع&lt;/span&gt;
                    &lt;/th&gt;
                    &lt;th style="width: 250px"&gt;&lt;span&gt;مثال&lt;/span&gt;
                    &lt;/th&gt;
                    &lt;th&gt;&lt;span&gt;ملاحظات&lt;/span&gt;
                    &lt;/th&gt;
				&lt;/tr&gt;
         

                &lt;tr&gt;
                    &lt;td&gt;تقريبي&lt;/td&gt;
                    &lt;td&gt;kettle&lt;b&gt;~&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;يحتوي على مصطلحات قريبة من كلمة &lt;i&gt;kettle&lt;/i&gt;، مثل &lt;i&gt;cattle&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;بدل&lt;/td&gt;
                    &lt;td&gt;cat*&lt;/td&gt;
                    &lt;td&gt;يحتوي على مصطلحات تبدأ بـ &lt;i&gt;cat&lt;/i&gt;، مثل &lt;i&gt;category&lt;/i&gt; والمصطلح التام &lt;i&gt;cat&lt;/i&gt; نفسه&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;تام-مفرد&lt;/td&gt;
                    &lt;td&gt;orange&lt;/td&gt;
                    &lt;td&gt;يحتوي على المصطلح &lt;i&gt;orange&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;تام-عبارة&lt;/td&gt;
                    &lt;td&gt;"dnn is awesome"&lt;/td&gt;
                    &lt;td&gt;يحتوي على العبارة التامة &lt;i&gt;dnn is awesome&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;أو&lt;/td&gt;
                    &lt;td&gt;orange bike&lt;/td&gt;
                    &lt;td&gt;يحتوي على المصطلح &lt;i&gt;orange&lt;/i&gt; أو &lt;i&gt;bike&lt;/i&gt; أو كليهما. &lt;b&gt;&lt;i&gt;OR&lt;/i&gt; يجب أن تُكتب بأحرف كبيرة عند استخدامها&lt;/b&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;&lt;/td&gt;
                    &lt;td&gt;orange &lt;b&gt;OR&lt;/b&gt; bike&lt;/td&gt;
                    &lt;td&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;و&lt;/td&gt;
                    &lt;td&gt;orange &lt;b&gt;AND&lt;/b&gt; bike&lt;/td&gt;
                    &lt;td&gt;يحتوي على &lt;i&gt;orange&lt;/i&gt; و&lt;i&gt;bike&lt;/i&gt; معًا. &lt;b&gt;&lt;i&gt;AND&lt;/i&gt; يجب أن تُكتب بأحرف كبيرة&lt;/b&gt;&lt;/td&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;مدمج&lt;/td&gt;
                    &lt;td&gt;(agile &lt;b&gt;OR&lt;/b&gt; extreme) &lt;b&gt;AND&lt;/b&gt; methodology&lt;/td&gt;
                    &lt;td&gt;يحتوي على &lt;i&gt;methodology&lt;/i&gt; ويجب أن يحتوي أيضًا على &lt;i&gt;agile&lt;/i&gt; و/أو &lt;i&gt;extreme&lt;/i&gt;
