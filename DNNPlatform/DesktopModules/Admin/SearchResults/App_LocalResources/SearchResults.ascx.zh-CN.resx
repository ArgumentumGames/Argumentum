  <data name="AdvancedSearchHint.Text" xml:space="preserve">
    <value>&lt;table class="dnnSearchResult-hint-tbl dnnTableDisplay"&gt;

                
				&lt;tr&gt;
                    &lt;th style="width: 150px"&gt;&lt;span&gt;类型&lt;/span&gt;
                    &lt;/th&gt;
                    &lt;th style="width: 250px"&gt;&lt;span&gt;示例&lt;/span&gt;
                    &lt;/th&gt;
                    &lt;th&gt;&lt;span&gt;说明&lt;/span&gt;
                    &lt;/th&gt;
				&lt;/tr&gt;
         

                &lt;tr&gt;
                    &lt;td&gt;模糊&lt;/td&gt;
                    &lt;td&gt;kettle&lt;b&gt;~&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;包含与 &lt;i&gt;kettle&lt;/i&gt; 相近的词条，例如 &lt;i&gt;cattle&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;通配&lt;/td&gt;
                    &lt;td&gt;cat*&lt;/td&gt;
                    &lt;td&gt;包含以 &lt;i&gt;cat&lt;/i&gt; 开头的词条，例如 &lt;i&gt;category&lt;/i&gt;，以及 &lt;i&gt;cat&lt;/i&gt; 本身&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;精确单词&lt;/td&gt;
                    &lt;td&gt;orange&lt;/td&gt;
                    &lt;td&gt;包含词条 &lt;i&gt;orange&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;精确短语&lt;/td&gt;
                    &lt;td&gt;"dnn is awesome"&lt;/td&gt;
                    &lt;td&gt;包含精确短语 &lt;i&gt;dnn is awesome&lt;/i&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;OR&lt;/td&gt;
                    &lt;td&gt;orange bike&lt;/td&gt;
                    &lt;td&gt;包含词条 &lt;i&gt;orange&lt;/i&gt; 或 &lt;i&gt;bike&lt;/i&gt;，或两者。如果使用 &lt;b&gt;&lt;i&gt;OR&lt;/i&gt;，必须大写&lt;/b&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;&lt;/td&gt;
                    &lt;td&gt;orange &lt;b&gt;OR&lt;/b&gt; bike&lt;/td&gt;
                    &lt;td&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;AND&lt;/td&gt;
                    &lt;td&gt;orange &lt;b&gt;AND&lt;/b&gt; bike&lt;/td&gt;
                    &lt;td&gt;同时包含 &lt;i&gt;orange&lt;/i&gt; 和 &lt;i&gt;bike&lt;/i&gt;。&lt;b&gt;&lt;i&gt;AND&lt;/i&gt; 必须大写&lt;/b&gt;&lt;/td&gt;&lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                    &lt;td&gt;组合&lt;/td&gt;
                    &lt;td&gt;(agile &lt;b&gt;OR&lt;/b&gt; extreme) &lt;b&gt;AND&lt;/b&gt; methodology&lt;/td&gt;
                    &lt;td&gt;包含 &lt;i&gt;methodology&lt;/i&gt;，并且还必须包含 &lt;i&gt;agile&lt;/i&gt; 和/或 &lt;i&gt;extreme&lt;/i&gt;
                &lt;/tr&gt;
            &lt;/table&gt;</value>
